index 41ba094..de70f66 100644
--- a/thirdparty/concurrentqueue/lightweightsemaphore.h
+++ b/thirdparty/concurrentqueue/lightweightsemaphore.h
@@ -24,6 +24,11 @@ extern "C" {
 }
 #elif defined(__MACH__)
 #include <mach/mach.h>
+#elif defined(__SWITCH__)
+#include <cassert>
+#include <chrono>
+#include <condition_variable>
+#include <mutex>
 #elif defined(__unix__)
 #include <semaphore.h>
 
@@ -253,6 +258,72 @@ public:
 		}
 	}
 };
+#elif defined(__SWITCH__)
+//---------------------------------------------------------
+// Semaphore (Nintendo Switch: libnx has no timed semaphore wait, so build one from a condition variable)
+//---------------------------------------------------------
+class Semaphore
+{
+private:
+	std::mutex m_mutex;
+	std::condition_variable m_cv;
+	int m_count;
+
+	Semaphore(const Semaphore& other) MOODYCAMEL_DELETE_FUNCTION;
+	Semaphore& operator=(const Semaphore& other) MOODYCAMEL_DELETE_FUNCTION;
+
+public:
+	Semaphore(int initialCount = 0) : m_count(initialCount)
+	{
+		assert(initialCount >= 0);
+	}
+
+	bool wait()
+	{
+		std::unique_lock<std::mutex> lock(m_mutex);
+		m_cv.wait(lock, [this] { return m_count > 0; });
+		--m_count;
+		return true;
+	}
+
+	bool try_wait()
+	{
+		std::lock_guard<std::mutex> lock(m_mutex);
+		if (m_count > 0) {
+			--m_count;
+			return true;
+		}
+		return false;
+	}
+
+	bool timed_wait(std::uint64_t usecs)
+	{
+		std::unique_lock<std::mutex> lock(m_mutex);
+		if (!m_cv.wait_for(lock, std::chrono::microseconds(usecs), [this] { return m_count > 0; })) {
+			return false;
+		}
+		--m_count;
+		return true;
+	}
+
+	void signal()
+	{
+		signal(1);
+	}
+
+	void signal(int count)
+	{
+		{
+			std::lock_guard<std::mutex> lock(m_mutex);
+			m_count += count;
+		}
+		if (count == 1) {
+			m_cv.notify_one();
+		} else {
+			m_cv.notify_all();
+		}
+	}
+};
 #else
 #error Unsupported platform! (No semaphore wrapper available)
 #endif
