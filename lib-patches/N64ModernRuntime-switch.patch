+// std::filesystem::copy_file relies on syscalls libnx doesn't implement, so copy with stdio instead.
+static bool copy_file_contents(const std::filesystem::path& from, const std::filesystem::path& to, std::error_code& ec) {
+    ec.clear();
+    FILE* in = fopen(from.string().c_str(), "rb");
+    if (in == nullptr) {
+        ec = std::make_error_code(std::errc::no_such_file_or_directory);
+        return false;
+    }
+    FILE* out = fopen(to.string().c_str(), "wb");
+    if (out == nullptr) {
+        fclose(in);
+        ec = std::make_error_code(std::errc::permission_denied);
+        return false;
+    }
+    char buffer[16 * 1024];
+    size_t count;
+    bool ok = true;
+    while ((count = fread(buffer, 1, sizeof(buffer), in)) > 0) {
+        if (fwrite(buffer, 1, count, out) != count) {
+            ok = false;
+            break;
+        }
+    }
+    fclose(in);
+    if (fclose(out) != 0 || !ok) {
+        ec = std::make_error_code(std::errc::io_error);
+        return false;
+    }
+    return true;
+}
+#else
+static bool copy_file_contents(const std::filesystem::path& from, const std::filesystem::path& to, std::error_code& ec) {
+    return std::filesystem::copy_file(from, to, std::filesystem::copy_options::overwrite_existing, ec);
+}
