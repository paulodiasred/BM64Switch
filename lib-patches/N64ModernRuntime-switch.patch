+#elif defined(__SWITCH__)
+#include <switch.h>
+
+// Horizon has no thread names, but threads are otherwise created on the process' default core, so use the name
+// to spread the busiest threads over the three cores an application can use.
+void ultramodern::set_native_thread_name(const std::string& name) {
+    int core;
+    if (name == "Gfx Thread") {
+        core = 1;
+    } else if (name == "SP Task Thread" || name == "VI Thread") {
+        core = 2;
+    } else {
+        core = 0;
+    }
+    svcSetThreadCoreMask(CUR_THREAD_HANDLE, core, 1u << core);
+}
+
+void ultramodern::set_native_thread_priority(ThreadPriority pri) {
+    // Horizon priorities go from 0 (highest) to 63; applications normally run at 0x2C.
+    int priority;
+    switch (pri) {
+        case ThreadPriority::Low:      priority = 0x2D; break;
+        case ThreadPriority::High:     priority = 0x2B; break;
+        case ThreadPriority::VeryHigh: priority = 0x2A; break;
+        case ThreadPriority::Critical: priority = 0x29; break;
+        default:                       priority = 0x2C; break;
+    }
+    svcSetThreadPriority(CUR_THREAD_HANDLE, priority);
+}
 #endif
 
