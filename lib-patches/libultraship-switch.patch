+void Interpreter::EnablePersistentShaderList(const std::string& path) {
+    // Guards against a corrupted file making startup take forever.
+    constexpr size_t max_shaders = 4096;
+    size_t created = 0;
+    if (FILE* in = fopen(path.c_str(), "rb")) {
+        uint64_t ids[2];
+        while (created < max_shaders && fread(ids, sizeof(ids), 1, in) == 1) {
+            if (mRapi->LookupShader(ids[0], ids[1]) == nullptr) {
+                ShaderProgram* prg = mRapi->CreateAndLoadNewShader(ids[0], ids[1]);
+                mRapi->UnloadShader(prg);
+                created++;
+            }
+        }
+        fclose(in);
+    }
+    SPDLOG_INFO("Precompiled {} shaders from {}", created, path);
+    mShaderListFile = fopen(path.c_str(), "ab");
+}
