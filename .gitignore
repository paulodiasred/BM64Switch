# ROMs: never commit them
*.z64
*.n64
*.v64

# Everything generated from the ROM (tools/generate.sh)
RecompiledFuncs/
RecompiledPatches/
rsp/
patches/*.o
patches/*.d
patches/*.elf
patches/*.bin
patches/*.map
*.map

# Build output
build-tools/
build-linux/
build-switch/
dist/
*.elf
*.nro
*.nacp

# Headless test runs (tools/test)
run/
run-*/

# Recompiler binaries copied to the root
/N64Recomp
/RSPRecomp

# Editors
.vscode/
.vs/
.DS_Store
imgui.ini

# Console keys and installable packages: never commit them
*.keys
*.nsp

# Python
__pycache__/

# Local icon override (e.g. the box art): used by the build when present, never committed
icons/custom-icon.jpg
